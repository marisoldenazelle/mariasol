# --- Fournisseur LLM -------------------------------------------------------
# albert | openai_compatible | offline
REGWATCH_LLM_PROVIDER=albert
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_API_KEY=

# Identifiant exact du modèle exposé par l'endpoint.
# À vérifier dans Administration > Modèle > Tester la connexion.
REGWATCH_LLM_MODEL=mistral-small-3-2-24b-instruct-2506

REGWATCH_LLM_TEMPERATURE=0.0
REGWATCH_LLM_RETRIES=2
REGWATCH_LLM_TIMEOUT=120

# --- Stockage --------------------------------------------------------------
REGWATCH_DB=data/regwatch.sqlite3
REGWATCH_AUDIT=1
